# Copy to .env and fill in values before: docker compose up --build

# ── Frontend (baked into the image at build time) ────────────
# Keep /api so nginx on the Linux host can proxy to the API container.
VITE_API_BASE_URL=/api
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Backend ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
JWT_SECRET=replace-with-a-long-random-secret
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/tce_apprisal
# Browser origin of the app on this server (scheme + host + port, no path).
# Examples: http://localhost:8080  or  https://appraisal.tce.edu
FRONTEND_ORIGIN=http://localhost:8080
PORT=5000
NODE_ENV=production

# ── Email / SMTP (optional) ──────────────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ── Linux server (busy host — unique ports) ──────────────────
# docker compose -f docker-compose.yml -f docker-compose.linux.yml up --build -d
# App:  http://SERVER_IP:30173
# API:  http://SERVER_IP:30173/api/health
# FRONTEND_ORIGIN=http://SERVER_IP:30173
# Add that origin to Google OAuth Authorized JavaScript origins.
# Do not reuse tce-app :30050 or another project's reverse proxy /api path.
